<Project>
  <!--
    Merkezi paket sürüm yönetimi. Sürümler önceden .csproj'lara dağılmıştı;
    özellikle Microsoft.Data.Sqlite bir projede, geçişli güvenlik açığını
    kapatan SQLitePCLRaw.lib.e_sqlite3 geçersiz kılması başka bir satırda
    duruyordu. Tek bir yerde durunca uyumsuz bir çift gözden kaçmıyor.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- Yalnız derleme zamanı: `dotnet ef dbcontext optimize` (derlenmiş model). EF Core ile aynı sürüm olmalı. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!--
      PDFsharp 6.2.4 geçişli olarak System.Security.Cryptography.Pkcs 8.0.1'i getiriyor;
      bu sürüm GHSA-846f-f764-76mx (yüksek) ve GHSA-2fmv-rv2c-59x7 (orta) açıklarını
      taşıyor. TreatWarningsAsErrors açık olduğundan NU1902/NU1903 temiz bir NuGet
      önbelleğinde geri yüklemeyi durduruyordu. İki açık da 10.x hattında 10.0.13'te
      kapandı; net10.0 hedefiyle ve Microsoft.Data.Sqlite 10.0.x ile aynı servis hattı.
      Infrastructure'daki açık PackageReference geçişli sürümü yükseltir
      (SQLitePCLRaw.lib.e_sqlite3 geçersiz kılmasıyla aynı desen). PDFsharp bir sonraki
      sürümde yamalı Pkcs'e geçtiğinde bu satır kaldırılabilir.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Geçişli 2.1.11 yerel SQLite paketindeki güvenlik açığını geçersiz kılar. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <!--
    Yalnız Android kabuğu (src/Metraj.Android, Metraj.Mobile.sln). Masaüstü
    çözümü bu paketleri geri yüklemez. AndroidX bağlamaları net10.0-android36.0
    hedefini taşıyan son sürümlerdir; birbirlerinin geçişli bağımlılıkları
    (Core 1.19.0.1, Kotlin StdLib 2.4.0.1) aynı servis hattındadır.
  -->
  <ItemGroup Label="Android">
    <PackageVersion Include="Xamarin.AndroidX.Activity" Version="1.13.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
    <PackageVersion Include="Xamarin.AndroidX.WebKit" Version="1.17.0" />
    <!--
      Infrastructure'ın kullandığı SQLitePCLRaw.lib.e_sqlite3 yalnız masaüstü/Linux
      (glibc) ikililerini getirir; Android'e bionic ikilisi bu paketten gelir.
      Sürüm yukarıdaki lib.e_sqlite3 ile aynı kalmalı.
    -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
