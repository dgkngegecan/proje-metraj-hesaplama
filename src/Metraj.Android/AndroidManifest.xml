<?xml version="1.0" encoding="utf-8"?>
<!--
  TAMAMEN YEREL: INTERNET izni BİLEREK yok. Arayüz APK'dan (WebViewAssetLoader),
  veri FilesDir'den gelir; WebView ile .NET süreç içi WebMessageListener ile
  konuşur, hiçbir port açılmaz. Release derlemesine .NET for Android de izin
  eklemez (Debug derlemesi hata ayıklayıcı için kendiliğinden INTERNET ekler).

  Yedekleme: proje verisi cihazdan Google yedeğine/cihaz aktarımına çıkmaz
  (allowBackup=false + kurallar her şeyi dışlar); kullanıcı yedeği Ayarlar →
  Yedekler / dışa aktarma ile kendisi alır.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:fullBackupContent="@xml/backup_rules"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:usesCleartextTraffic="false"
      android:supportsRtl="true">

    <!-- Paylaşım için önbellekteki dışa aktarımlar (CacheDir/exports) geçici okuma izniyle verilir. -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="dev.projemetraj.app.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
    </provider>

    <!-- Güvenli Tarama URL'leri Google'a sorar; uygulama yalnız kendi varlıklarını açar. -->
    <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
    <!-- WebView kullanım ölçümlerini gönderme. -->
    <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
  </application>
</manifest>
